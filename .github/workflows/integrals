<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bản Chất Tích Phân & Diện Tích (Why Integrals = Area)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Math.js CDN for expression parsing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.8.0/math.js"></script>
    <!-- FontAwesome CDN for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        darkbg: '#070a13',
                        panelbg: 'rgba(15, 23, 42, 0.75)',
                        bordercolor: 'rgba(255, 255, 255, 0.08)',
                        brandcyan: '#06b6d4',
                        brandemerald: '#10b981',
                        brandamber: '#f59e0b',
                        brandpink: '#ec4899',
                        brandpurple: '#a855f7'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #070a13;
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.4);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #070a13;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }

        /* Mode Tab Active styling */
        .tab-active {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(168, 85, 247, 0.25));
            border-color: #6366f1;
            color: #ffffff;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
        }

        /* Pulsing & Glowing elements */
        .glow-box-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.3);
        }
        .glow-box-amber {
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
        }
        .glow-box-purple {
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
        }

        canvas {
            touch-action: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col text-gray-100 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Application Header -->
    <header class="border-b border-gray-800/80 bg-[#0a0f1d]/90 backdrop-blur-md sticky top-0 z-50 px-4 py-3">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 via-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <span class="font-serif text-2xl font-bold text-white italic">∫</span>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold bg-gradient-to-r from-white via-cyan-200 to-indigo-300 bg-clip-text text-transparent">
                        Bản Chất Tích Phân & Diện Tích
                    </h1>
                    <p class="text-xs text-gray-400">Tại sao Tích phân là Diện tích dưới đường cong? $\int_a^b f(x)dx$</p>
                </div>
            </div>

            <!-- Mode Selector Navigation -->
            <div class="flex items-center bg-gray-900/80 p-1 rounded-xl border border-gray-800 text-xs font-medium self-start md:self-auto overflow-x-auto max-w-full">
                <button id="tabMode1" class="tab-btn tab-active px-3.5 py-2 rounded-lg border border-transparent transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-lightbulb text-amber-400"></i>
                    <span>1. Bản Chất $A'(x) = f(x)$</span>
                </button>
                <button id="tabMode2" class="tab-btn px-3.5 py-2 rounded-lg border border-transparent text-gray-400 hover:text-white transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-chart-simple text-cyan-400"></i>
                    <span>2. Chia Nhỏ Riemann $N \rightarrow \infty$</span>
                </button>
                <button id="tabMode3" class="tab-btn px-3.5 py-2 rounded-lg border border-transparent text-gray-400 hover:text-white transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-car text-emerald-400"></i>
                    <span>3. Chuyển Động $v(t) \rightarrow S(t)$</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-3 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Sidebar Controls & Inputs (4 Cols) -->
        <section class="lg:col-span-4 flex flex-col gap-5">

            <!-- Function Input Box -->
            <div class="glass-panel rounded-2xl p-4 md:p-5 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-300 flex items-center gap-2">
                        <i class="fa-solid fa-square-root-variable text-cyan-400"></i> Hàm Số $f(x)$ / $v(t)$
                    </h2>
                    <span id="evalStatus" class="text-xs px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/50">Hợp lệ ✓</span>
                </div>

                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400 font-mono font-bold text-sm">
                        f(x) =
                    </span>
                    <input type="text" id="functionInput" value="0.2*x^2 + 1" 
                           class="w-full bg-gray-900/90 border border-cyan-500/40 rounded-xl pl-16 pr-10 py-2.5 text-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all shadow-inner"
                           placeholder="Nhập hàm số, ví dụ: 0.2*x^2 + 1">
                    <button id="clearInputBtn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500 hover:text-gray-300 transition-colors">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>
                <p id="errorText" class="text-xs text-rose-400 hidden font-mono bg-rose-950/40 p-2 rounded border border-rose-800/40"></p>

                <!-- Presets -->
                <div>
                    <label class="text-[11px] font-medium text-gray-400 mb-1.5 block">Hàm mẫu thử nghiệm:</label>
                    <div class="grid grid-cols-2 gap-1.5">
                        <button class="preset-btn text-xs font-mono py-1.5 px-2 rounded-lg bg-gray-800/80 hover:bg-cyan-600/30 hover:border-cyan-500/50 border border-gray-700/60 text-gray-200 transition-all truncate text-left" data-func="0.2*x^2 + 1">
                            f(x) = 0.2x² + 1
                        </button>
                        <button class="preset-btn text-xs font-mono py-1.5 px-2 rounded-lg bg-gray-800/80 hover:bg-cyan-600/30 hover:border-cyan-500/50 border border-gray-700/60 text-gray-200 transition-all truncate text-left" data-func="sin(x) + 2">
                            f(x) = sin(x) + 2
                        </button>
                        <button class="preset-btn text-xs font-mono py-1.5 px-2 rounded-lg bg-gray-800/80 hover:bg-cyan-600/30 hover:border-cyan-500/50 border border-gray-700/60 text-gray-200 transition-all truncate text-left" data-func="0.5*x + 1.5">
                            f(x) = 0.5x + 1.5
                        </button>
                        <button class="preset-btn text-xs font-mono py-1.5 px-2 rounded-lg bg-gray-800/80 hover:bg-cyan-600/30 hover:border-cyan-500/50 border border-gray-700/60 text-gray-200 transition-all truncate text-left" data-func="0.1*x^3 - 0.5*x + 2">
                            f(x) = 0.1x³-0.5x+2
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dynamic Controls Panel -->
            <div class="glass-panel rounded-2xl p-4 md:p-5 flex flex-col gap-4">
                
                <!-- Shared Bounds A and B -->
                <div class="grid grid-cols-2 gap-3 pb-2 border-b border-gray-800">
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-400">Cận dưới ($a$):</span>
                            <span id="valA" class="font-mono text-cyan-400 font-bold">0.0</span>
                        </div>
                        <input type="range" id="sliderA" min="-3.0" max="2.0" step="0.1" value="0.0" 
                               class="w-full accent-cyan-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-400">Cận trên ($b$):</span>
                            <span id="valB" class="font-mono text-cyan-400 font-bold">4.0</span>
                        </div>
                        <input type="range" id="sliderB" min="1.0" max="6.0" step="0.1" value="4.0" 
                               class="w-full accent-cyan-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>
                </div>

                <!-- MODE 1 CONTROLS -->
                <div id="controlsMode1" class="space-y-4">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-amber-300 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-amber-400"></i> Điều Khiển Dải Mỏng $\Delta x$
                    </h3>

                    <!-- Position x slider -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-amber-300">Vị trí xét $x$:</span>
                            <span id="valX" class="font-mono text-amber-400 font-bold">2.50</span>
                        </div>
                        <input type="range" id="sliderX" min="0.1" max="3.8" step="0.05" value="2.5" 
                               class="w-full accent-amber-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>

                    <!-- Delta x slider -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-pink-300">Chiều rộng dải $\Delta x$:</span>
                            <span id="valDx" class="font-mono text-pink-400 font-bold">0.80</span>
                        </div>
                        <input type="range" id="sliderDx" min="0.01" max="1.5" step="0.01" value="0.8" 
                               class="w-full accent-pink-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>

                    <!-- Action Button: Animate dx -> 0 -->
                    <button id="btnShrinkDx" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 via-pink-600 to-purple-600 hover:from-amber-400 hover:to-purple-500 text-white font-semibold text-xs shadow-lg shadow-pink-500/20 transition-all flex items-center justify-center gap-2 group">
                        <i class="fa-solid fa-compress group-hover:scale-110 transition-transform"></i>
                        <span>Bóp chiều rộng $\Delta x \rightarrow 0$ (Xem $A'(x) \rightarrow f(x)$)</span>
                    </button>
                </div>

                <!-- MODE 2 CONTROLS -->
                <div id="controlsMode2" class="space-y-4 hidden">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-cyan-300 flex items-center gap-2">
                        <i class="fa-solid fa-bars-staggered text-cyan-400"></i> Tham Số Tổng Riemann
                    </h3>

                    <!-- Number of rects N -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-cyan-300">Số lượng hình chia $N$:</span>
                            <span id="valN" class="font-mono text-cyan-400 font-bold">8</span>
                        </div>
                        <input type="range" id="sliderN" min="2" max="200" step="1" value="8" 
                               class="w-full accent-cyan-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>

                    <!-- Riemann Method Toggles -->
                    <div>
                        <label class="text-[11px] font-medium text-gray-400 mb-1.5 block">Phương pháp xấp xỉ:</label>
                        <div class="grid grid-cols-2 gap-1.5 text-xs">
                            <button class="method-btn py-1.5 px-2 rounded-lg bg-cyan-600/30 border border-cyan-500 text-cyan-200 font-medium" data-method="left">
                                Left (Trái)
                            </button>
                            <button class="method-btn py-1.5 px-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-300 hover:text-white" data-method="right">
                                Right (Phải)
                            </button>
                            <button class="method-btn py-1.5 px-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-300 hover:text-white" data-method="mid">
                                Midpoint (Giữa)
                            </button>
                            <button class="method-btn py-1.5 px-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-300 hover:text-white" data-method="trap">
                                Hình Thang
                            </button>
                        </div>
                    </div>

                    <!-- Action Button: Animate N -> infinity -->
                    <button id="btnAnimateN" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-600 via-indigo-600 to-purple-600 hover:from-cyan-500 hover:to-purple-500 text-white font-semibold text-xs shadow-lg shadow-indigo-500/20 transition-all flex items-center justify-center gap-2 group">
                        <i class="fa-solid fa-circle-nodes group-hover:rotate-45 transition-transform"></i>
                        <span>Tăng $N \rightarrow \infty$ (Biến hình chữ nhật thành liên tục)</span>
                    </button>
                </div>

                <!-- MODE 3 CONTROLS -->
                <div id="controlsMode3" class="space-y-4 hidden">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-300 flex items-center gap-2">
                        <i class="fa-solid fa-gauge-high text-emerald-400"></i> Điều Khiển Xe Chuyển Động
                    </h3>

                    <div class="grid grid-cols-2 gap-2">
                        <button id="btnPlayMotion" class="py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20">
                            <i id="playIcon" class="fa-solid fa-play"></i>
                            <span id="playText">Chạy Xe</span>
                        </button>
                        <button id="btnResetMotion" class="py-2.5 px-3 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold text-xs transition-all flex items-center justify-center gap-2 border border-gray-700">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>Về 0</span>
                        </button>
                    </div>

                    <div class="space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-emerald-300">Thời gian $t$:</span>
                            <span id="valSimT" class="font-mono text-emerald-400 font-bold">0.00s</span>
                        </div>
                        <input type="range" id="sliderSimT" min="0" max="4" step="0.02" value="0" 
                               class="w-full accent-emerald-400 h-1.5 bg-gray-800 rounded-lg appearance-none cursor-pointer">
                    </div>
                </div>

            </div>

            <!-- Mathematical Metrics & Live Comparison Box -->
            <div class="glass-panel rounded-2xl p-4 md:p-5 flex flex-col gap-3">
                <h2 class="text-xs font-bold uppercase tracking-wider text-purple-300 flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-purple-400"></i> Giá Trị Tích Phân & Sai Số
                </h2>

                <div class="space-y-2 text-xs font-mono">
                    <div class="flex justify-between items-center p-2 rounded-lg bg-gray-900/70 border border-cyan-500/20">
                        <span class="text-gray-400">Tích phân chính xác $\int_a^b f(x)dx$:</span>
                        <span id="metricExactArea" class="text-cyan-300 font-bold text-sm">6.133</span>
                    </div>

                    <div id="metricApproxRow" class="flex justify-between items-center p-2 rounded-lg bg-gray-900/70 border border-purple-500/20">
                        <span id="metricApproxLabel" class="text-gray-400">Tổng Riemann $S_N$:</span>
                        <span id="metricApproxVal" class="text-purple-300 font-bold text-sm">6.520</span>
                    </div>

                    <div id="metricErrorRow" class="flex justify-between items-center p-2 rounded-lg bg-gray-900/70 border border-pink-500/20">
                        <span class="text-gray-400">Sai số tuyệt đối $|\Delta|$:</span>
                        <span id="metricErrorVal" class="text-pink-400 font-bold">0.387 (6.3%)</span>
                    </div>
                </div>
            </div>

        </section>

        <!-- Right Visualizer Viewports (8 Cols) -->
        <section class="lg:col-span-8 flex flex-col gap-4">

            <!-- MAIN DUAL/SINGLE CANVAS DISPLAY -->
            <div class="glass-panel rounded-2xl p-3 md:p-4 flex flex-col gap-3 relative overflow-hidden">
                
                <!-- Viewport Indicator Header -->
                <div class="flex items-center justify-between text-xs text-gray-400 px-1">
                    <div class="flex items-center gap-2 font-medium">
                        <span id="canvasTitle1" class="text-cyan-300 flex items-center gap-1">
                            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span> Đồ thị Hàm số $f(x)$ & Diện tích $A(x)$
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-[11px] text-gray-400">
                        <span>💡 Di chuột/chạm đồ thị để khám phá toạ độ</span>
                    </div>
                </div>

                <!-- Canvas Shell -->
                <div class="relative w-full aspect-[4/3] md:aspect-[16/10] bg-[#050811] rounded-xl border border-gray-800/80 overflow-hidden shadow-2xl flex flex-col">
                    <canvas id="primaryCanvas" class="w-full h-full block cursor-crosshair"></canvas>
                </div>

                <!-- MODE 3 Motion Track (Only visible in Mode 3) -->
                <div id="motionTrackContainer" class="hidden flex-col gap-2 p-3 bg-[#050811] rounded-xl border border-emerald-500/30">
                    <div class="flex justify-between items-center text-xs font-mono">
                        <span class="text-emerald-400 font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-road text-emerald-500"></i> Đường Chạy Xe Real-time (Độ dời $S(t)$)
                        </span>
                        <span class="text-gray-300">Vận tốc $v(t)$: <strong id="carSpeedText" class="text-cyan-300">2.25 m/s</strong> | Quãng đường $S(t)$: <strong id="carDistText" class="text-emerald-300">4.12 m</strong></span>
                    </div>
                    <!-- Track canvas -->
                    <div class="relative w-full h-16 bg-gray-900/90 rounded-lg overflow-hidden border border-gray-800">
                        <canvas id="trackCanvas" class="w-full h-full block"></canvas>
                    </div>
                </div>

            </div>

            <!-- Interactive Pedagogical Explanation Banner -->
            <div id="explanationBox" class="glass-panel rounded-2xl p-4 md:p-5 border-l-4 border-l-cyan-500">
                
                <!-- Dynamic Content injected via JS based on Active Mode -->
                <div id="expMode1">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-key text-amber-400"></i>
                        Vì Sao Tích Phân Tương Đương Diện Tích? (Định Lý Cơ Bản Giải Tích)
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-gray-300 leading-relaxed">
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-amber-300 mb-1">1. Tốc độ tăng diện tích $\Delta A / \Delta x$:</p>
                            <p>Khi kéo dịch chuyển $x$ thêm một khoảng cực nhỏ $\Delta x$, diện tích tăng thêm một dải mỏng $\Delta A \approx f(x) \cdot \Delta x$. Tỉ số $\frac{\Delta A}{\Delta x} \approx f(x)$.</p>
                        </div>
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-cyan-300 mb-1">2. Đạo hàm của Diện tích $A'(x) = f(x)$:</p>
                            <p>Khi cho $\Delta x \rightarrow 0$, ta có $\lim_{\Delta x \rightarrow 0} \frac{\Delta A}{\Delta x} = A'(x) = f(x)$. **Độ cao đường cong chính là đạo hàm của hàm diện tích!** Do đó, muốn tìm diện tích $A(x)$, ta tìm **nguyên hàm (tích phân)** của $f(x)$.</p>
                        </div>
                    </div>
                </div>

                <div id="expMode2" class="hidden">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-cubes text-cyan-400"></i>
                        Tổng Riemann & Sự Chuyển Hóa Rời Rạc $\rightarrow$ Liên Tục
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-gray-300 leading-relaxed">
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-purple-300 mb-1">1. Xấp xỉ bằng thanh hình chữ nhật:</p>
                            <p>Diện tích được xấp xỉ bằng tổng diện tích các cột nhỏ: $S_N = \sum_{i=1}^N f(x_i^*) \Delta x$, trong đó $\Delta x = \frac{b-a}{N}$.</p>
                        </div>
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-emerald-300 mb-1">2. Giới hạn khi $N \rightarrow \infty$:</p>
                            <p>Khi số thanh $N$ tiến đến vô cùng, độ rộng $\Delta x \rightarrow dx$ nhỏ vô hạn. Các khe hở biến mất hoàn toàn và tổng rời rạc biến thành **Tích phân xác định $\int_a^b f(x)dx$**.</p>
                        </div>
                    </div>
                </div>

                <div id="expMode3" class="hidden">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-person-walking-arrow-right text-emerald-400"></i>
                        Ý Nghĩa Vật Lý: Vận Tốc Tích Lũy Thành Quãng Đường
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-gray-300 leading-relaxed">
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-emerald-300 mb-1">1. Dải quãng đường siêu ngắn $dS$:</p>
                            <p>Trong khoảng thời gian vô cùng nhỏ $dt$, xe chạy với vận tốc $v(t)$. Quãng đường đi được là $dS = v(t) \cdot dt$ (đúng bằng diện tích hình chữ nhật mỏng cao $v(t)$, rộng $dt$).</p>
                        </div>
                        <div class="bg-gray-900/60 p-3 rounded-xl border border-gray-800">
                            <p class="font-bold text-cyan-300 mb-1">2. Tổng quãng đường tích lũy $S(t)$:</p>
                            <p>Tổng quãng đường đi được từ $t=0$ đến $t$ chính là **tổng toàn bộ diện tích nằm dưới đồ thị vận tốc**: $S(t) = \int_0^t v(\tau)d\tau$.</p>
                        </div>
                    </div>
                </div>

            </div>

        </section>

    </main>

    <script>
        (function() {
            // Global Application State
            const state = {
                activeMode: 1, // 1: Intuition A'(x)=f(x), 2: Riemann Sum N->Inf, 3: Motion v(t)->S(t)
                funcStr: "0.2*x^2 + 1",
                compiledFunc: null,
                a: 0.0,
                b: 4.0,
                
                // Mode 1 state
                x1: 2.5,
                dx: 0.8,
                isShrinkingDx: false,

                // Mode 2 state
                N: 8,
                method: 'left', // left, right, mid, trap
                isAnimatingN: false,

                // Mode 3 state
                simT: 0.0,
                isSimPlaying: false,
                simAnimId: null,

                // Viewport domains
                xMin: -1.0,
                xMax: 5.5,
                yMin: -0.5,
                yMax: 5.5
            };

            // Canvas References
            const primaryCanvas = document.getElementById('primaryCanvas');
            const primaryCtx = primaryCanvas.getContext('2d');
            const trackCanvas = document.getElementById('trackCanvas');
            const trackCtx = trackCanvas.getContext('2d');

            // UI Elements
            const functionInput = document.getElementById('functionInput');
            const evalStatus = document.getElementById('evalStatus');
            const errorText = document.getElementById('errorText');
            const sliderA = document.getElementById('sliderA');
            const sliderB = document.getElementById('sliderB');
            const valA = document.getElementById('valA');
            const valB = document.getElementById('valB');

            // Mode 1 UI
            const sliderX = document.getElementById('sliderX');
            const sliderDx = document.getElementById('sliderDx');
            const valX = document.getElementById('valX');
            const valDx = document.getElementById('valDx');
            const btnShrinkDx = document.getElementById('btnShrinkDx');

            // Mode 2 UI
            const sliderN = document.getElementById('sliderN');
            const valN = document.getElementById('valN');
            const btnAnimateN = document.getElementById('btnAnimateN');

            // Mode 3 UI
            const btnPlayMotion = document.getElementById('btnPlayMotion');
            const playIcon = document.getElementById('playIcon');
            const playText = document.getElementById('playText');
            const btnResetMotion = document.getElementById('btnResetMotion');
            const sliderSimT = document.getElementById('sliderSimT');
            const valSimT = document.getElementById('valSimT');
            const carSpeedText = document.getElementById('carSpeedText');
            const carDistText = document.getElementById('carDistText');

            // Metrics UI
            const metricExactArea = document.getElementById('metricExactArea');
            const metricApproxLabel = document.getElementById('metricApproxLabel');
            const metricApproxVal = document.getElementById('metricApproxVal');
            const metricErrorVal = document.getElementById('metricErrorVal');

            // Math Expression Compiler
            function parseFunction(expr) {
                try {
                    let sanitized = expr.replace(/(\d+)([a-zA-Z])/g, '$1*$2');
                    const compiled = math.compile(sanitized);
                    // Test evaluation
                    const testVal = compiled.evaluate({ x: 1 });
                    if (typeof testVal !== 'number' || isNaN(testVal)) {
                        throw new Error("Kết quả không phải số thực");
                    }
                    state.compiledFunc = compiled;
                    state.funcStr = expr;
                    evalStatus.textContent = "Hợp lệ ✓";
                    evalStatus.className = "text-xs px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/50";
                    errorText.classList.add('hidden');
                    autoScaleViewport();
                    return true;
                } catch (err) {
                    evalStatus.textContent = "Lỗi cú pháp ✗";
                    evalStatus.className = "text-xs px-2 py-0.5 rounded bg-rose-950/80 text-rose-400 border border-rose-800/50";
                    errorText.textContent = "Cú pháp chưa đúng. Hãy thử: 0.2*x^2 + 1, sin(x) + 2, 0.5*x + 1";
                    errorText.classList.remove('hidden');
                    return false;
                }
            }

            function f(x) {
                if (!state.compiledFunc) return 0;
                try {
                    const res = state.compiledFunc.evaluate({ x: x });
                    if (isNaN(res) || !isFinite(res)) return 0;
                    return res;
                } catch (e) {
                    return 0;
                }
            }

            // Accurate Simpson's Numerical Definite Integral
            function computeExactIntegral(fromX, toX) {
                if (fromX >= toX) return 0;
                const steps = 1000;
                const h = (toX - fromX) / steps;
                let sum = f(fromX) + f(toX);

                for (let i = 1; i < steps; i++) {
                    const x = fromX + i * h;
                    sum += f(x) * (i % 2 === 0 ? 2 : 4);
                }
                return (sum * h) / 3;
            }

            // Riemann Sum Calculation
            function computeRiemannSum(a, b, N, method) {
                const dx = (b - a) / N;
                let total = 0;

                for (let i = 0; i < N; i++) {
                    let sampleX = a;
                    if (method === 'left') {
                        sampleX = a + i * dx;
                        total += f(sampleX) * dx;
                    } else if (method === 'right') {
                        sampleX = a + (i + 1) * dx;
                        total += f(sampleX) * dx;
                    } else if (method === 'mid') {
                        sampleX = a + (i + 0.5) * dx;
                        total += f(sampleX) * dx;
                    } else if (method === 'trap') {
                        const xLeft = a + i * dx;
                        const xRight = a + (i + 1) * dx;
                        total += ((f(xLeft) + f(xRight)) / 2) * dx;
                    }
                }
                return total;
            }

            // Auto-scale viewport Y axis
            function autoScaleViewport() {
                state.xMin = Math.min(state.a - 1.0, -1.0);
                state.xMax = Math.max(state.b + 1.5, 5.0);

                let maxY = -Infinity;
                let minY = Infinity;
                const steps = 200;
                const dx = (state.xMax - state.xMin) / steps;

                for (let i = 0; i <= steps; i++) {
                    const x = state.xMin + i * dx;
                    const y = f(x);
                    if (y > maxY) maxY = y;
                    if (y < minY) minY = y;
                }

                if (minY === Infinity || maxY === -Infinity) {
                    state.yMin = -0.5;
                    state.yMax = 5.0;
                } else {
                    state.yMin = Math.min(0, minY - 0.5);
                    state.yMax = Math.max(1.0, maxY * 1.25);
                }
            }

            // Coordinate transformations
            function getDimensions(cvs) {
                const rect = cvs.getBoundingClientRect();
                const dpr = window.devicePixelRatio || 1;
                if (cvs.width !== rect.width * dpr || cvs.height !== rect.height * dpr) {
                    cvs.width = rect.width * dpr;
                    cvs.height = rect.height * dpr;
                }
                return { width: cvs.width, height: cvs.height, dpr };
            }

            function toScreenX(x, width) {
                return ((x - state.xMin) / (state.xMax - state.xMin)) * width;
            }

            function toMathX(px, width) {
                return state.xMin + (px / width) * (state.xMax - state.xMin);
            }

            function toScreenY(y, height, topOffset = 0, subHeight = null) {
                const h = subHeight || height;
                return topOffset + h - ((y - state.yMin) / (state.yMax - state.yMin)) * h;
            }

            // Main Canvas Render Orchestrator
            function render() {
                const { width, height } = getDimensions(primaryCanvas);
                primaryCtx.clearRect(0, 0, width, height);

                if (state.activeMode === 1) {
                    renderMode1(width, height);
                } else if (state.activeMode === 2) {
                    renderMode2(width, height);
                } else if (state.activeMode === 3) {
                    renderMode3(width, height);
                    renderTrack();
                }

                updateMetricsUI();
            }

            function renderMode1(width, height) {
                // Split into 2 vertical viewports: Top (65% height) for f(x), Bottom (35% height) for A(x)
                const topH = height * 0.62;
                const botH = height * 0.38;

                // 1. Top Viewport Background & Grid
                drawGrid(primaryCtx, width, topH, 0, "Top: f(x) & Dải diện tích ΔA");

                // 2. Bottom Viewport Background & Grid
                drawGrid(primaryCtx, width, botH, topH, "Bottom: Đường cong Tích Lũy Diện Tích A(x)");

                // Draw Separator Line
                primaryCtx.strokeStyle = '#1e293b';
                primaryCtx.lineWidth = 2;
                primaryCtx.beginPath();
                primaryCtx.moveTo(0, topH);
                primaryCtx.lineTo(width, topH);
                primaryCtx.stroke();

                // --- TOP VIEWPORT: f(x) ---
                // Draw curve f(x)
                drawCurve(primaryCtx, width, topH, 0, '#06b6d4', 3);

                // Draw shaded area A(x) from 'a' to 'x'
                const xA = state.a;
                const x1 = state.x1;
                const x2 = state.x1 + state.dx;

                // Area A(x) shade (Cyan)
                fillAreaUnderCurve(primaryCtx, width, topH, 0, xA, x1, 'rgba(6, 182, 212, 0.25)');

                // Slice ΔA shade (Pink/Amber glowing)
                fillAreaUnderCurve(primaryCtx, width, topH, 0, x1, x2, 'rgba(236, 72, 153, 0.45)');

                // Draw Slice outlines & bounds
                const sx1 = toScreenX(x1, width);
                const sx2 = toScreenX(x2, width);
                const sy1 = toScreenY(f(x1), topH, 0);
                const sy2 = toScreenY(f(x2), topH, 0);
                const syZeroTop = toScreenY(0, topH, 0);

                // Dải mỏng ΔA border
                primaryCtx.save();
                primaryCtx.strokeStyle = '#ec4899';
                primaryCtx.lineWidth = 2;
                primaryCtx.setLineDash([4, 3]);
                primaryCtx.beginPath();
                primaryCtx.moveTo(sx1, syZeroTop);
                primaryCtx.lineTo(sx1, sy1);
                primaryCtx.lineTo(sx2, sy2);
                primaryCtx.lineTo(sx2, syZeroTop);
                primaryCtx.stroke();
                primaryCtx.restore();

                // Annotate Δx and ΔA on Top
                primaryCtx.fillStyle = '#f472b6';
                primaryCtx.font = 'bold 12px "JetBrains Mono", monospace';
                primaryCtx.textAlign = 'center';
                if (Math.abs(sx2 - sx1) > 15) {
                    primaryCtx.fillText("ΔA", (sx1 + sx2) / 2, (sy1 + syZeroTop) / 2);
                    primaryCtx.fillText("Δx", (sx1 + sx2) / 2, syZeroTop - 8);
                }

                // Point A on Top Curve f(x1)
                primaryCtx.beginPath();
                primaryCtx.arc(sx1, sy1, 6, 0, Math.PI * 2);
                primaryCtx.fillStyle = '#f59e0b';
                primaryCtx.fill();
                primaryCtx.strokeStyle = '#ffffff';
                primaryCtx.lineWidth = 2;
                primaryCtx.stroke();

                // --- BOTTOM VIEWPORT: Cumulative Area A(x) ---
                // Plot A(x) = \int_a^x f(t) dt
                const maxMathYArea = computeExactIntegral(state.a, state.xMax);
                const areaStep = 2;
                primaryCtx.save();
                primaryCtx.beginPath();
                primaryCtx.strokeStyle = '#a855f7';
                primaryCtx.lineWidth = 3.5;
                primaryCtx.shadowColor = '#a855f7';
                primaryCtx.shadowBlur = 10;

                let started = false;
                for (let px = 0; px <= width; px += areaStep) {
                    const mx = toMathX(px, width);
                    if (mx >= state.a) {
                        const areaVal = computeExactIntegral(state.a, mx);
                        // Map areaVal to bottom viewport height
                        const syBot = topH + botH - (areaVal / Math.max(maxMathYArea, 1.0)) * (botH * 0.75) - 25;
                        if (!started) {
                            primaryCtx.moveTo(px, syBot);
                            started = true;
                        } else {
                            primaryCtx.lineTo(px, syBot);
                        }
                    }
                }
                primaryCtx.stroke();
                primaryCtx.restore();

                // Highlight Point on A(x) curve and show its Tangent Line (Slope = f(x))
                const currentAreaVal = computeExactIntegral(state.a, x1);
                const syBotPoint = topH + botH - (currentAreaVal / Math.max(maxMathYArea, 1.0)) * (botH * 0.75) - 25;

                // Vertical projection sync line connecting Top and Bottom
                primaryCtx.strokeStyle = 'rgba(245, 158, 11, 0.4)';
                primaryCtx.lineWidth = 1.5;
                primaryCtx.setLineDash([4, 4]);
                primaryCtx.beginPath();
                primaryCtx.moveTo(sx1, sy1);
                primaryCtx.lineTo(sx1, syBotPoint);
                primaryCtx.stroke();
                primaryCtx.setLineDash([]);

                // Draw Tangent line on A(x) at x1
                const slope = f(x1); // Fundamental Theorem: A'(x1) = f(x1)
                const tangPxLen = 60;
                primaryCtx.save();
                primaryCtx.strokeStyle = '#f59e0b';
                primaryCtx.lineWidth = 2.5;
                primaryCtx.shadowColor = '#f59e0b';
                primaryCtx.shadowBlur = 8;
                primaryCtx.beginPath();
                primaryCtx.moveTo(sx1 - tangPxLen, syBotPoint + tangPxLen * (slope * 0.15));
                primaryCtx.lineTo(sx1 + tangPxLen, syBotPoint - tangPxLen * (slope * 0.15));
                primaryCtx.stroke();
                primaryCtx.restore();

                // Draw Point on A(x)
                primaryCtx.beginPath();
                primaryCtx.arc(sx1, syBotPoint, 7, 0, Math.PI * 2);
                primaryCtx.fillStyle = '#a855f7';
                primaryCtx.fill();
                primaryCtx.strokeStyle = '#ffffff';
                primaryCtx.lineWidth = 2;
                primaryCtx.stroke();

                // Label on Tangent Line
                primaryCtx.fillStyle = '#f59e0b';
                primaryCtx.font = 'bold 11px "Inter", sans-serif';
                primaryCtx.textAlign = 'left';
                primaryCtx.fillText(`Độ dốc tiếp tuyến A'(x) = f(x) = ${slope.toFixed(2)}`, sx1 + 12, syBotPoint - 10);
            }

            function renderMode2(width, height) {
                // Background & Grid
                drawGrid(primaryCtx, width, height, 0, "Tổng Riemann $S_N$ & Đường Cong Liên Tục");

                const a = state.a;
                const b = state.b;
                const N = state.N;
                const method = state.method;
                const dx = (b - a) / N;

                const syZero = toScreenY(0, height, 0);

                // Draw Riemann Rectangles / Trapezoids
                primaryCtx.save();
                for (let i = 0; i < N; i++) {
                    const xLeft = a + i * dx;
                    const xRight = a + (i + 1) * dx;
                    const sxL = toScreenX(xLeft, width);
                    const sxR = toScreenX(xRight, width);

                    if (method === 'trap') {
                        const yL = f(xLeft);
                        const yR = f(xRight);
                        const syL = toScreenY(yL, height, 0);
                        const syR = toScreenY(yR, height, 0);

                        primaryCtx.fillStyle = 'rgba(6, 182, 212, 0.25)';
                        primaryCtx.strokeStyle = 'rgba(6, 182, 212, 0.8)';
                        primaryCtx.lineWidth = N > 60 ? 0.5 : 1.5;

                        primaryCtx.beginPath();
                        primaryCtx.moveTo(sxL, syZero);
                        primaryCtx.lineTo(sxL, syL);
                        primaryCtx.lineTo(sxR, syR);
                        primaryCtx.lineTo(sxR, syZero);
                        primaryCtx.closePath();
                        primaryCtx.fill();
                        primaryCtx.stroke();
                    } else {
                        let sampleX = xLeft;
                        if (method === 'right') sampleX = xRight;
                        if (method === 'mid') sampleX = xLeft + dx / 2;

                        const heightY = f(sampleX);
                        const syHeight = toScreenY(heightY, height, 0);

                        // Fill
                        primaryCtx.fillStyle = (i % 2 === 0) ? 'rgba(6, 182, 212, 0.3)' : 'rgba(99, 102, 241, 0.3)';
                        primaryCtx.fillRect(sxL, syHeight, sxR - sxL, syZero - syHeight);

                        // Stroke border
                        if (N <= 80) {
                            primaryCtx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
                            primaryCtx.lineWidth = 1;
                            primaryCtx.strokeRect(sxL, syHeight, sxR - sxL, syZero - syHeight);
                        }

                        // Sample point indicator dot
                        if (N <= 30) {
                            const sxSample = toScreenX(sampleX, width);
                            primaryCtx.beginPath();
                            primaryCtx.arc(sxSample, syHeight, 3.5, 0, Math.PI * 2);
                            primaryCtx.fillStyle = '#f59e0b';
                            primaryCtx.fill();
                        }
                    }
                }
                primaryCtx.restore();

                // Draw Smooth Function Curve f(x) over top
                drawCurve(primaryCtx, width, height, 0, '#ffffff', 3.5);

                // Draw Bounds lines a and b
                drawVerticalBoundLine(primaryCtx, width, height, a, '#10b981', 'a');
                drawVerticalBoundLine(primaryCtx, width, height, b, '#f43f5e', 'b');
            }

            function renderMode3(width, height) {
                // Draw Grid
                drawGrid(primaryCtx, width, height, 0, "Đồ Thị Vận Tốc v(t) theo Thời Gian t");

                const tCurrent = state.simT;

                // Shade accumulated area S(t) under v(t) from 0 to tCurrent
                fillAreaUnderCurve(primaryCtx, width, height, 0, 0, tCurrent, 'rgba(16, 185, 129, 0.35)');

                // Draw velocity curve
                drawCurve(primaryCtx, width, height, 0, '#10b981', 3.5);

                // Time Scanner Line at tCurrent
                const sxT = toScreenX(tCurrent, width);
                const vVal = f(tCurrent);
                const syV = toScreenY(vVal, height, 0);
                const syZero = toScreenY(0, height, 0);

                primaryCtx.save();
                primaryCtx.strokeStyle = '#34d399';
                primaryCtx.lineWidth = 2.5;
                primaryCtx.setLineDash([5, 4]);
                primaryCtx.beginPath();
                primaryCtx.moveTo(sxT, syZero);
                primaryCtx.lineTo(sxT, syV);
                primaryCtx.stroke();
                primaryCtx.restore();

                // Scanner Point
                primaryCtx.beginPath();
                primaryCtx.arc(sxT, syV, 7, 0, Math.PI * 2);
                primaryCtx.fillStyle = '#10b981';
                primaryCtx.shadowColor = '#10b981';
                primaryCtx.shadowBlur = 12;
                primaryCtx.fill();
                primaryCtx.strokeStyle = '#ffffff';
                primaryCtx.lineWidth = 2;
                primaryCtx.stroke();

                // Annotation
                primaryCtx.fillStyle = '#34d399';
                primaryCtx.font = 'bold 12px "Inter", sans-serif';
                primaryCtx.textAlign = 'left';
                primaryCtx.fillText(`v(${tCurrent.toFixed(2)}) = ${vVal.toFixed(2)} m/s`, sxT + 10, syV - 8);
            }

            // Render Track for Mode 3
            function renderTrack() {
                const { width, height } = getDimensions(trackCanvas);
                trackCtx.clearRect(0, 0, width, height);

                // Road markings
                trackCtx.fillStyle = '#0f172a';
                trackCtx.fillRect(0, 0, width, height);

                const roadY = height / 2;
                trackCtx.strokeStyle = '#334155';
                trackCtx.lineWidth = 2;
                trackCtx.setLineDash([12, 8]);
                trackCtx.beginPath();
                trackCtx.moveTo(0, roadY);
                trackCtx.lineTo(width, roadY);
                trackCtx.stroke();
                trackCtx.setLineDash([]);

                // Calculate distance traveled S(t)
                const distS = computeExactIntegral(0, state.simT);
                const maxDist = computeExactIntegral(0, 4.0);

                // Map distance to pixel position on road
                const startPx = 40;
                const endPx = width - 50;
                const carPx = startPx + (distS / Math.max(maxDist, 1.0)) * (endPx - startPx);

                // Update text overlays
                carSpeedText.textContent = `${f(state.simT).toFixed(2)} m/s`;
                carDistText.textContent = `${distS.toFixed(2)} m`;

                // Draw Vehicle (Stylized Sci-Fi Sports Car / Runner)
                trackCtx.save();
                trackCtx.translate(carPx, roadY);

                // Vehicle body glowing shadow
                trackCtx.fillStyle = 'rgba(16, 185, 129, 0.4)';
                trackCtx.shadowColor = '#10b981';
                trackCtx.shadowBlur = 15;
                trackCtx.fillRect(-22, -12, 44, 20);

                // Vehicle Main Body
                trackCtx.fillStyle = '#10b981';
                trackCtx.beginPath();
                trackCtx.roundRect(-20, -10, 40, 18, 6);
                trackCtx.fill();

                // Windshield
                trackCtx.fillStyle = '#06b6d4';
                trackCtx.beginPath();
                trackCtx.roundRect(-4, -8, 12, 14, 3);
                trackCtx.fill();

                // Wheels
                trackCtx.fillStyle = '#ffffff';
                trackCtx.beginPath();
                trackCtx.arc(-12, 8, 4, 0, Math.PI * 2);
                trackCtx.arc(12, 8, 4, 0, Math.PI * 2);
                trackCtx.fill();

                trackCtx.restore();
            }

            function drawGrid(c, width, height, topOffset, title) {
                c.save();
                c.fillStyle = '#050811';
                c.fillRect(0, topOffset, width, height);

                // Axis styling
                c.strokeStyle = '#1f293d';
                c.lineWidth = 1;

                // Vertical Grid
                const xStep = 1.0;
                for (let x = Math.ceil(state.xMin); x <= state.xMax; x += xStep) {
                    const sx = toScreenX(x, width);
                    c.beginPath();
                    c.moveTo(sx, topOffset);
                    c.lineTo(sx, topOffset + height);
                    c.stroke();

                    // Label
                    c.fillStyle = '#475569';
                    c.font = '10px "JetBrains Mono", monospace';
                    c.textAlign = 'center';
                    c.fillText(x.toFixed(0), sx, topOffset + height - 6);
                }

                // Horizontal Axis (y=0)
                const syZero = toScreenY(0, height, topOffset);
                c.strokeStyle = '#334155';
                c.lineWidth = 1.5;
                c.beginPath();
                c.moveTo(0, syZero);
                c.lineTo(width, syZero);
                c.stroke();

                // Subgraph Title
                c.fillStyle = '#94a3b8';
                c.font = '11px "Inter", sans-serif';
                c.textAlign = 'left';
                c.fillText(title, 12, topOffset + 18);

                c.restore();
            }

            function drawCurve(c, width, height, topOffset, strokeColor, lineWidth) {
                const step = 2;
                c.save();
                c.strokeStyle = strokeColor;
                c.lineWidth = lineWidth;
                c.shadowColor = strokeColor;
                c.shadowBlur = 8;
                c.beginPath();

                let started = false;
                for (let px = 0; px <= width; px += step) {
                    const x = toMathX(px, width);
                    const y = f(x);
                    const sy = toScreenY(y, height, topOffset);

                    if (!started) {
                        c.moveTo(px, sy);
                        started = true;
                    } else {
                        c.lineTo(px, sy);
                    }
                }
                c.stroke();
                c.restore();
            }

            function fillAreaUnderCurve(c, width, height, topOffset, fromX, toX, fillColor) {
                if (fromX >= toX) return;
                const step = 2;
                const syZero = toScreenY(0, height, topOffset);

                c.save();
                c.fillStyle = fillColor;
                c.beginPath();

                const startPx = toScreenX(fromX, width);
                const endPx = toScreenX(toX, width);

                c.moveTo(startPx, syZero);

                for (let px = startPx; px <= endPx; px += step) {
                    const x = toMathX(px, width);
                    const y = f(x);
                    const sy = toScreenY(y, height, topOffset);
                    c.lineTo(px, sy);
                }

                c.lineTo(endPx, syZero);
                c.closePath();
                c.fill();
                c.restore();
            }

            function drawVerticalBoundLine(c, width, height, xVal, color, label) {
                const sx = toScreenX(xVal, width);
                const syZero = toScreenY(0, height, 0);
                const syTop = toScreenY(f(xVal), height, 0);

                c.save();
                c.strokeStyle = color;
                c.lineWidth = 2;
                c.setLineDash([4, 4]);
                c.beginPath();
                c.moveTo(sx, syZero);
                c.lineTo(sx, syTop);
                c.stroke();

                c.fillStyle = color;
                c.font = 'bold 12px "JetBrains Mono", monospace';
                c.textAlign = 'center';
                c.fillText(`${label} = ${xVal.toFixed(1)}`, sx, syZero - 8);
                c.restore();
            }

            function updateMetricsUI() {
                valA.textContent = state.a.toFixed(1);
                valB.textContent = state.b.toFixed(1);

                const exact = computeExactIntegral(state.a, state.b);
                metricExactArea.textContent = exact.toFixed(3);

                if (state.activeMode === 1) {
                    valX.textContent = state.x1.toFixed(2);
                    valDx.textContent = state.dx.toFixed(2);

                    const deltaA = computeExactIntegral(state.x1, state.x1 + state.dx);
                    const ratio = deltaA / state.dx;
                    const fxVal = f(state.x1);

                    metricApproxLabel.textContent = "Tỉ số ΔA / Δx:";
                    metricApproxVal.textContent = ratio.toFixed(3);

                    const diff = Math.abs(ratio - fxVal);
                    metricErrorVal.textContent = `So với f(x)=${fxVal.toFixed(3)}: Lệch ${diff.toFixed(3)}`;
                } else if (state.activeMode === 2) {
                    valN.textContent = state.N;
                    const approx = computeRiemannSum(state.a, state.b, state.N, state.method);

                    metricApproxLabel.textContent = `Tổng Riemann S_${state.N}:`;
                    metricApproxVal.textContent = approx.toFixed(3);

                    const err = Math.abs(approx - exact);
                    const percent = exact !== 0 ? ((err / Math.abs(exact)) * 100).toFixed(2) : '0';
                    metricErrorVal.textContent = `${err.toFixed(3)} (${percent}%)`;
                } else if (state.activeMode === 3) {
                    valSimT.textContent = `${state.simT.toFixed(2)}s`;
                    const distS = computeExactIntegral(0, state.simT);

                    metricApproxLabel.textContent = "Quãng đường S(t):";
                    metricApproxVal.textContent = `${distS.toFixed(3)} m`;

                    metricErrorVal.textContent = `Vận tốc v(t) = ${f(state.simT).toFixed(2)} m/s`;
                }
            }

            function bindEvents() {
                // Tab Mode Switching
                document.getElementById('tabMode1').addEventListener('click', () => switchMode(1));
                document.getElementById('tabMode2').addEventListener('click', () => switchMode(2));
                document.getElementById('tabMode3').addEventListener('click', () => switchMode(3));

                function switchMode(m) {
                    state.activeMode = m;
                    document.querySelectorAll('.tab-btn').forEach((b, idx) => {
                        if (idx + 1 === m) {
                            b.className = "tab-btn tab-active px-3.5 py-2 rounded-lg border border-transparent transition-all flex items-center gap-2 whitespace-nowrap";
                        } else {
                            b.className = "tab-btn px-3.5 py-2 rounded-lg border border-transparent text-gray-400 hover:text-white transition-all flex items-center gap-2 whitespace-nowrap";
                        }
                    });

                    // Toggle sidebar controls
                    document.getElementById('controlsMode1').classList.toggle('hidden', m !== 1);
                    document.getElementById('controlsMode2').classList.toggle('hidden', m !== 2);
                    document.getElementById('controlsMode3').classList.toggle('hidden', m !== 3);

                    // Toggle track container
                    document.getElementById('motionTrackContainer').classList.toggle('hidden', m !== 3);

                    // Toggle explanations
                    document.getElementById('expMode1').classList.toggle('hidden', m !== 1);
                    document.getElementById('expMode2').classList.toggle('hidden', m !== 2);
                    document.getElementById('expMode3').classList.toggle('hidden', m !== 3);

                    render();
                }

                // Function input
                functionInput.addEventListener('input', (e) => {
                    parseFunction(e.target.value);
                    render();
                });

                document.getElementById('clearInputBtn').addEventListener('click', () => {
                    functionInput.value = '';
                    functionInput.focus();
                });

                // Presets
                document.querySelectorAll('.preset-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const func = btn.getAttribute('data-func');
                        functionInput.value = func;
                        parseFunction(func);
                        render();
                    });
                });

                // Bounds A and B
                sliderA.addEventListener('input', (e) => {
                    state.a = parseFloat(e.target.value);
                    if (state.a >= state.b) state.a = state.b - 0.2;
                    render();
                });

                sliderB.addEventListener('input', (e) => {
                    state.b = parseFloat(e.target.value);
                    if (state.b <= state.a) state.b = state.a + 0.2;
                    render();
                });

                // Mode 1 Sliders
                sliderX.addEventListener('input', (e) => {
                    state.x1 = parseFloat(e.target.value);
                    render();
                });

                sliderDx.addEventListener('input', (e) => {
                    state.dx = parseFloat(e.target.value);
                    render();
                });

                // Action: Animate dx -> 0
                btnShrinkDx.addEventListener('click', () => {
                    if (state.isShrinkingDx) return;
                    state.isShrinkingDx = true;

                    const startDx = state.dx;
                    const targetDx = 0.01;
                    const duration = 1200;
                    const startTime = performance.now();

                    function step(now) {
                        const elapsed = now - startTime;
                        const progress = Math.min(elapsed / duration, 1.0);
                        const ease = 1 - Math.pow(1 - progress, 3);

                        state.dx = startDx + (targetDx - startDx) * ease;
                        sliderDx.value = state.dx;
                        render();

                        if (progress < 1.0) {
                            requestAnimationFrame(step);
                        } else {
                            state.isShrinkingDx = false;
                        }
                    }
                    requestAnimationFrame(step);
                });

                // Mode 2 Sliders & Methods
                sliderN.addEventListener('input', (e) => {
                    state.N = parseInt(e.target.value);
                    render();
                });

                document.querySelectorAll('.method-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.method-btn').forEach(b => {
                            b.className = "method-btn py-1.5 px-2 rounded-lg bg-gray-800 border border-gray-700 text-gray-300 hover:text-white";
                        });
                        btn.className = "method-btn py-1.5 px-2 rounded-lg bg-cyan-600/30 border border-cyan-500 text-cyan-200 font-medium";
                        state.method = btn.getAttribute('data-method');
                        render();
                    });
                });

                // Action: Animate N -> infinity
                btnAnimateN.addEventListener('click', () => {
                    if (state.isAnimatingN) return;
                    state.isAnimatingN = true;

                    const startN = 2;
                    const targetN = 150;
                    const duration = 2000;
                    const startTime = performance.now();

                    function step(now) {
                        const elapsed = now - startTime;
                        const progress = Math.min(elapsed / duration, 1.0);

                        state.N = Math.round(startN + (targetN - startN) * progress);
                        sliderN.value = state.N;
                        render();

                        if (progress < 1.0) {
                            requestAnimationFrame(step);
                        } else {
                            state.isAnimatingN = false;
                        }
                    }
                    requestAnimationFrame(step);
                });

                // Mode 3 Controls
                btnPlayMotion.addEventListener('click', () => {
                    state.isSimPlaying = !state.isSimPlaying;
                    if (state.isSimPlaying) {
                        playIcon.className = "fa-solid fa-pause";
                        playText.textContent = "Tạm dừng";
                        tickMotion();
                    } else {
                        playIcon.className = "fa-solid fa-play";
                        playText.textContent = "Chạy Xe";
                    }
                });

                btnResetMotion.addEventListener('click', () => {
                    state.isSimPlaying = false;
                    playIcon.className = "fa-solid fa-play";
                    playText.textContent = "Chạy Xe";
                    state.simT = 0.0;
                    sliderSimT.value = 0;
                    render();
                });

                sliderSimT.addEventListener('input', (e) => {
                    state.simT = parseFloat(e.target.value);
                    render();
                });

                function tickMotion() {
                    if (!state.isSimPlaying) return;
                    state.simT += 0.015;
                    if (state.simT > 4.0) {
                        state.simT = 0.0;
                    }
                    sliderSimT.value = state.simT;
                    render();
                    requestAnimationFrame(tickMotion);
                }

                // Window Resize
                window.addEventListener('resize', () => {
                    render();
                });
            }

            window.addEventListener('load', () => {
                parseFunction(state.funcStr);
                bindEvents();
                render();
            });

        })();
    </script>
</body>
</html>
