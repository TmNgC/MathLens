<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dãy Euler & Số e — MathLens</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #05060a; color: #f3f5f7; font-family: 'Inter', system-ui, sans-serif; overflow-x: hidden; }
  
  .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
  header { margin-bottom: 20px; }
  .eyebrow { font-size: 12px; letter-spacing: 0.25em; text-transform: uppercase; color: #38bdf8; margin-bottom: 6px; }
  h1 { font-family: Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 400; color: #fff; }
  
  .visualizer-card { background: #0b0f19; border: 1px solid #1e293b; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.6); position: relative; }
  canvas { display: block; width: 100%; height: 480px; background: #05070d; }

  .hud { position: absolute; left: 24px; top: 24px; pointer-events: none; background: rgba(11, 15, 25, 0.85); backdrop-filter: blur(8px); padding: 16px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); }
  .stats { font-family: monospace; font-size: 15px; color: #94a3b8; line-height: 1.8; }
  .stats b { color: #fff; font-size: 18px; }
  .highlight { color: #f59e0b; text-shadow: 0 0 10px rgba(245,158,11,0.4); }
  .zoom-tag { color: #38bdf8; font-weight: bold; margin-left: 8px; font-size: 13px; }

  .controls-bar { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; background: #0f172a; border-top: 1px solid #1e293b; }
  .btn { background: #0284c7; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .btn:hover { background: #0369a1; }

  /* Section Giải thích */
  .explanation-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 30px; }
  .info-box { background: #0b0f19; border: 1px solid #1e293b; border-radius: 12px; padding: 24px; }
  .info-box h3 { color: #38bdf8; font-size: 18px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .info-box p { color: #94a3b8; font-size: 14.5px; line-height: 1.7; margin-bottom: 12px; }
  .info-box ul { color: #cbd5e1; font-size: 14px; line-height: 1.8; padding-left: 20px; }
  .formula-badge { background: #1e293b; color: #f59e0b; font-family: Georgia, serif; padding: 3px 8px; border-radius: 4px; font-size: 15px; }
</style>
</head>
<body>

<div class="container">
  <header>
    <div class="eyebrow">Giải Tích Toán Học · Giới Hạn Vô Cùng</div>
    <h1>Dãy Số Euler & Sự Ra Đời Của Hằng Số e</h1>
  </header>

  <div class="visualizer-card">
    <div class="hud">
      <div class="stats">
        Bước n: <b id="val-n">1</b> <span id="zoom-info" class="zoom-tag">Zoom: 1x</span><br>
        Giá trị a_n: <b class="highlight" id="val-an">2.000000000</b><br>
        Hằng số e: <b style="color:#2ed573">2.718281828</b><br>
        Khoảng cách (e - a_n): <b id="val-gap" style="color:#ef4444">0.718281828</b>
      </div>
    </div>

    <canvas id="eulerCanvas"></canvas>

    <div class="controls-bar">
      <span style="color:#64748b; font-size:14px">Camera tự động phóng đại khi n tăng ra vô cực</span>
      <button class="btn" id="btnToggle">Tạm dừng / Tiếp tục</button>
    </div>
  </div>

  <!-- Phần giải thích bản chất toán học -->
  <div class="explanation-grid">
    <div class="info-box">
      <h3>📜 Nguồn Gốc Lịch Sử (Bài Toán Lãi Kép)</h3>
      <p>Năm 1683, nhà toán học <b>Jacob Bernoulli</b> nghiên cứu một bài toán tài chính:</p>
      <p>Nếu bạn gửi <b>$1</b> vào ngân hàng với lãi suất <b>100%/năm</b>:</p>
      <ul>
        <li>Tính lãi 1 lần/năm: Bạn nhận <span class="formula-badge">(1 + 1)¹ = $2</span></li>
        <li>Tính lãi 2 lần/năm (mỗi nửa năm 50%): <span class="formula-badge">(1 + 1/2)² = $2.25</span></li>
        <li>Tính lãi 12 lần/tháng: <span class="formula-badge">(1 + 1/12)¹² = $2.613</span></li>
        <li>Tính lãi liên tục vô hạn lần ($n \to \infty$): Số tiền sẽ tiến tới một con số kỳ diệu... chính là <b>e ≈ 2.71828</b>.</li>
      </ul>
    </div>

    <div class="info-box">
      <h3>⚡ Vì Sao Số e Lại Cực Kỳ Quan Trọng?</h3>
      <p>Số $e$ không phải do con người tự nghĩ ra, nó là <b>hằng số tự nhiên của sự tăng trưởng</b>:</p>
      <ul>
        <li><b>Đạo hàm hoàn hảo:</b> Hàm số $f(x) = e^x$ có đạo hàm bằng chính nó ($\frac{d}{dx}e^x = e^x$). Đây là hàm duy nhất giữ nguyên tốc độ biến thiên.</li>
        <li><b>Tự nhiên & Sinh học:</b> Sự phân rã hạt nhân, sự gia tăng dân số, sự lây lan vi-rút đều tuân theo hàm mũ cơ số $e$.</li>
        <li><b>Đẳng thức đẹp nhất toán học:</b> Kết nối 5 hằng số vĩ đại $e^{i\pi} + 1 = 0$.</li>
      </ul>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('eulerCanvas');
const ctx = canvas.getContext('2d');

let W, H;
function resize() {
  W = canvas.width = canvas.offsetWidth;
  H = canvas.height = canvas.offsetHeight;
}
window.addEventListener('resize', resize);
resize();

const E = Math.E;
let n = 1;
let isRunning = true;
let historyData = [];
const maxHistory = 60; // Số điểm tối đa hiển thị trên màn hình

// Xử lý chính xác giá trị an khi n rất lớn
function getEulerValue(step) {
  if (step < 1e7) {
    return Math.pow(1 + 1 / step, step);
  }
  // Xấp xỉ Taylor khi n quá lớn để tránh tràn số float trong JS
  return E * (1 - 0.5 / step);
}

// Lerp cho hiệu ứng Zoom mượt mà
let currentYSpan = 1.5;
let targetYSpan = 1.5;

function draw() {
  ctx.clearRect(0, 0, W, H);

  const currentAn = getEulerValue(n);
  const gap = E - currentAn;

  // Cập nhật target zoom (khi gap thu nhỏ, YSpan thu nhỏ tương ứng)
  targetYSpan = Math.max(gap * 3.5, 1e-12);
  currentYSpan += (targetYSpan - currentYSpan) * 0.08; // Damping smooth lerp

  const paddingX = 80;
  const centerY = H * 0.4; // Đưa đường e lên vị trí 40% màn hình
  const yScale = (H * 0.45) / currentYSpan;

  // Chuyển đổi giá trị Y sang Tọa độ Canvas
  const toScreenY = (val) => centerY - (val - E) * yScale;

  // 1. Vẽ Đường Tiệm Cận y = e (Glowing Line)
  const eScreenY = toScreenY(E);
  ctx.strokeStyle = '#2ed573';
  ctx.lineWidth = 2;
  ctx.shadowColor = '#2ed573';
  ctx.shadowBlur = 12;
  ctx.beginPath();
  ctx.moveTo(paddingX, eScreenY);
  ctx.lineTo(W - 40, eScreenY);
  ctx.stroke();
  ctx.shadowBlur = 0;

  // Label đường tiệm cận
  ctx.fillStyle = '#2ed573';
  ctx.font = 'bold 13px monospace';
  ctx.fillText(`Tiệm cận y = e (2.71828...)`, W - 230, eScreenY - 10);

  // 2. Vẽ Lưới Tọa Độ Nằm Ngang Dộng
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
  ctx.lineWidth = 1;
  for (let i = -3; i <= 3; i++) {
    let gridY = eScreenY + i * (H / 6);
    ctx.beginPath();
    ctx.moveTo(paddingX, gridY); ctx.lineTo(W - 40, gridY);
    ctx.stroke();
  }

  // 3. Vẽ Đồ Thị Các Bước n
  if (historyData.length > 1) {
    ctx.strokeStyle = '#f59e0b';
    ctx.lineWidth = 2.5;
    ctx.beginPath();

    historyData.forEach((pt, idx) => {
      let x = paddingX + (idx / (maxHistory - 1)) * (W - paddingX - 60);
      let y = toScreenY(pt.val);
      if (idx === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Vẽ các điểm Scatter
    historyData.forEach((pt, idx) => {
      let x = paddingX + (idx / (maxHistory - 1)) * (W - paddingX - 60);
      let y = toScreenY(pt.val);
      let isLast = idx === historyData.length - 1;

      ctx.fillStyle = isLast ? '#38bdf8' : '#f59e0b';
      ctx.beginPath();
      ctx.arc(x, y, isLast ? 6 : 3, 0, Math.PI * 2);
      ctx.fill();

      if (isLast) {
        // Dóng chỉ dẫn từ điểm cuối lên tiệm cận e
        ctx.strokeStyle = 'rgba(245, 158, 11, 0.4)';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x, eScreenY);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    });
  }

  // Update HUD Text
  document.getElementById('val-n').innerText = Math.floor(n).toLocaleString();
  document.getElementById('val-an').innerText = currentAn.toFixed(9);
  document.getElementById('val-gap').innerText = gap < 1e-9 ? gap.toExponential(3) : gap.toFixed(9);
  
  let zoomLevel = (1.5 / currentYSpan).toFixed(1);
  document.getElementById('zoom-info').innerText = `Zoom: ${Number(zoomLevel).toLocaleString()}x`;

  // Logic Tăng n & Lưu dữ liệu
  if (isRunning) {
    historyData.push({ n, val: currentAn });
    if (historyData.length > maxHistory) historyData.shift();

    // Tốc độ tăng n tăng dần theo cấp số nhân
    if (n < 20) n += 1;
    else if (n < 1000) n = Math.floor(n * 1.1) + 1;
    else if (n < 1e12) n = Math.floor(n * 1.25) + 1;
  }

  requestAnimationFrame(draw);
}

document.getElementById('btnToggle').addEventListener('click', () => {
  isRunning = !isRunning;
});

draw();
</script>
</body>
</html>
